extends ../layouts/default.pug
include ../mixins/box-breadcrumb.pug
include ../mixins/product-item.pug

block main
  
  // Box Breadcrumb
  +box-breadcrumb(breadcrumb)
  // End Box Breadcrumb

  // Section 9
  .section-9
    .container
      .inner-wrap
        .inner-left
          // Box Filter
          .box-filter
            .inner-head
              .inner-title Bộ Lọc
              i.fa-solid.fa-filter
            .inner-body
              .inner-group
                label.inner-label(for="") Điểm đi
                select(name="")
                  option(value="") -- Chọn điểm đi --
                  option(value="") Hà Nội
                  option(value="") Đà Nẵng
                  option(value="") Nha Trang
              .inner-group
                label.inner-label(for="") Điểm đến
                select(name="")
                  option(value="") -- Chọn điểm đến --
                  option(value="") Hà Nội
                  option(value="") Đà Nẵng
                  option(value="") Nha Trang
              .inner-group
                label.inner-label(for="") Ngày khởi hành
                input(
                  name="" 
                  type="date"
                  )
              .inner-group
                label.inner-label(for="") Số Lượng Hành Khách
                .inner-input-list
                  .inner-input-item
                    span Người lớn:
                    input(
                      value="0" 
                      name="" 
                      type="number"
                      )
                  .inner-input-item
                    span Trẻ em:
                    input(
                      value="0" 
                      name="" 
                      type="number"
                      )
                  .inner-input-item
                    span Em bé:
                    input(
                      value="0" 
                      name="" 
                      type="number"
                      )
              .inner-group
                label.inner-label(for="") Mức giá
                select(name="")
                  option(value="") -- Chọn khoảng giá --
                  option(value="") Dưới 1tr
                  option(value="") Từ 1tr đến 3tr
                  option(value="") Từ 3tr đến 6tr
                  option(value="") Từ 6tr đến 10tr
                  option(value="") Trên 10tr
              .inner-group
                button.inner-button Áp Dụng
          .inner-overlay
          // End Box Filter
        .inner-right
          .inner-info
            h2.inner-title #{category.name}
            .inner-desc
              | !{category.description}
          .inner-info-2
            .inner-sort
              .inner-label Sắp xếp :
              .inner-list
                button
                  | Giá tăng dần
                  i.fa-solid.fa-square-caret-up
                button
                  | Giá giảm dần
                  i.fa-solid.fa-square-caret-down
                button.active
                  | Khuyến Mại Hot
                  i.fa-solid.fa-tag
                button
                  | Xem Nhiều
                  i.fa-solid.fa-eye
            .inner-count-record
              | Tất cả:
              b #{tourListSection9.length} Tour
            button.inner-filter-mobile
              span.inner-title Bộ Lọc
              i.fa-solid.fa-filter
          .inner-list-tour
            each item in tourListSection9
              +product-item(item)
          // Pagination
          .box-pagination
            button
              i.fa-solid.fa-angles-left
            button.active 1
            button 2
            button 3
            button 4
            button
              i.fa-solid.fa-angles-right
          // End Pagination
  // End Section 9