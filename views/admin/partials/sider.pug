nav.sider
  ul.inner-menu
    //- 1. Tổng quan
    if(account.permissions.includes("dashboard-view"))
      li
        a(href=`/${pathAdmin}/dashboard`) <i class="fa-solid fa-gauge-high"></i> Tổng quan
    
    //- 2. Quản lý danh mục
    if(account.permissions.includes("category-view"))
      li
        a(href=`/${pathAdmin}/category/list`) <i class="fa-solid fa-table-list"></i> Quản lý danh mục
    
    //- 3. Quản lý tour
    if(account.permissions.includes("tour-view"))
      li
        a(href=`/${pathAdmin}/tour/list`) <i class="fa-solid fa-table-list"></i> Quản lý tour

    //- 4. Quản lý đơn hàng (MỚI BỌC)
    if(account.permissions.includes("order-view"))
      li
        a(href=`/${pathAdmin}/order/list`) <i class="fa-solid fa-list-check"></i> Quản lý đơn hàng

    //- 5. Quản lý tài khoản Admin (MỚI BỌC)
    if(account.permissions.includes("user-view"))
      li
        a(href=`/${pathAdmin}/user/list`) <i class="fa-solid fa-user"></i> Quản lý người dùng

    //- 6. Thông tin liên hệ (MỚI BỌC)
    if(account.permissions.includes("contact-view"))
      li
        a(href=`/${pathAdmin}/contact/list`) <i class="fa-solid fa-user-group"></i> Thông tin liên hệ

  hr
  ul.inner-menu
    //- 7. Cài đặt chung (MỚI BỌC - ĐÂY LÀ CHỖ ÔNG THẮC MẮC)
    if(account.permissions.includes("setting-view"))
      li
        a(href=`/${pathAdmin}/setting/list`) <i class="fa-solid fa-gear"></i> Cài đặt chung
    
    li
      a(href=`/${pathAdmin}/profile/edit`) <i class="fa-solid fa-user-gear"></i> Thông tin cá nhân
    li
      a(href="javascript:;" class="inner-logout") <i class="fa-solid fa-power-off"></i> Đăng xuất
.sider-overlay