extends ../layouts/default.pug

block main
  h1.box-title Đơn hàng: #{orderDetail.code}

  .section-8
    form#order-edit-form
      .inner-group(style="display: none;")
        input(type="text" name="id" value=orderDetail.id)
      .inner-group
        label(class="inner-label" for="fullName") Tên khách hàng
        input(type="text" id="fullName" name="fullName" value=orderDetail.fullName)
      .inner-group
        label(class="inner-label" for="phone") Số điện thoại
        input(type="text" id="phone" name="phone" value=orderDetail.phone)
      .inner-group.inner-two-col
        label(class="inner-label" for="note") Ghi chú
        textarea(id="note" name="note") #{orderDetail.note}
      .inner-group
        label(class="inner-label" for="paymentMethod") Phương thức thanh toán
        select(id="paymentMethod" name="paymentMethod")
          option(
            value="money"
            selected=(orderDetail.paymentMethod == "money" ? true : false)
          ) Tiền mặt
          option(
            value="bank"
            selected=(orderDetail.paymentMethod == "bank" ? true : false)
          ) Tài khoản ngân hàng
          option(
            value="momo"
            selected=(orderDetail.paymentMethod == "momo" ? true : false)
          ) Ví Momo
          option(
            value="vnpay"
            selected=(orderDetail.paymentMethod == "vnpay" ? true : false)
          ) VNPay
          option(
            value="zalopay"
            selected=(orderDetail.paymentMethod == "zalopay" ? true : false)
          ) ZaloPay
      .inner-group
        label(class="inner-label" for="paymentStatus") Trạng thái thanh toán
        select(id="paymentStatus" name="paymentStatus")
          option(
            value="paid"
            selected=(orderDetail.paymentStatus == "paid" ? true : false)
          ) Đã thanh toán
          option(
            value="unpaid"
            selected=(orderDetail.paymentStatus == "unpaid" ? true : false)
          ) Chưa thanh toán
      .inner-group
        label(class="inner-label" for="createdAt") Ngày đặt
        input(type="datetime-local" id="createdAt" name="createdAt" value=orderDetail.createdAtFormat readonly)
      .inner-group
        label(class="inner-label" for="status") Trạng thái
        select(id="status" name="status")
          option(
            value="initial"
            selected=(orderDetail.status == "initial" ? true : false)
          ) Khởi tạo
          option(
            value="done"
            selected=(orderDetail.status == "done" ? true : false)
          ) Hoàn thành
          option(
            value="cancel"
            selected=(orderDetail.status == "cancel" ? true : false)
          ) Hủy
      .inner-group
        label(class="inner-label") Danh sách tour
        .inner-order-list
          each item in orderDetail.items
            .inner-order-item
              .inner-order-image
                img(src=item.avatar, alt=item.name)
              .inner-order-content
                .inner-order-name #{item.name}
                if(item.quantityAdult > 0)
                  .inner-order-text Người lớn: #{item.quantityAdult} x #{item.priceNewAdult.toLocaleString("vi-VN")}đ
                if(item.quantityChildren > 0)
                  .inner-order-text Trẻ em: #{item.quantityChildren} x #{item.priceNewChildren.toLocaleString("vi-VN")}đ
                if(item.quantityBaby > 0)
                  .inner-order-text Em bé: #{item.quantityBaby} x #{item.priceNewBaby.toLocaleString("vi-VN")}đ
                .inner-order-text Ngày khởi hành: #{item.departureDateFormat}
                .inner-order-text Khởi hành tại: #{item.locationFromName}
      .inner-group
        label(class="inner-label") Thanh toán
          .inner-order-total
            div Tổng tiền: #{orderDetail.subTotal.toLocaleString("vi-VN")}đ
            div Giảm: 0đ
            div Mã giảm: 
            div Thanh toán: <span class="inner-order-price">#{orderDetail.total.toLocaleString("vi-VN")}đ</span>
      .inner-button.inner-two-col
        button Cập nhật
    .inner-back
      a(href=`/${pathAdmin}/order/list`) Quay lại danh sách