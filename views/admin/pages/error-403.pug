extends ../layouts/default.pug

block main
  .section-10
    .inner-lock <i class="fa-solid fa-lock"></i>
    h1(class="inner-title") Bạn không có quyền xem trang này
    if(account.permissions.includes("dashboard-view"))
      a(href=`/${pathAdmin}/dashboard` class="inner-back") Trở về trang tổng quan
    else
      a(href=`/${pathAdmin}/profile/edit` class="inner-back") Trở về thông tin cá nhân
