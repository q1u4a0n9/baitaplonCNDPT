doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title #{pageTitle}
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css")
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/filepond@4.32.7/dist/filepond.min.css")
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/filepond-plugin-image-preview@4.6.12/dist/filepond-plugin-image-preview.min.css")
    link(rel="stylesheet", href="/admin/assets/css/style.css")
    script(src="https://cdn.tiny.cloud/1/gbyrkpar0rld8xofyemstlrzdcqir2930qn7fn3pnwxnp8o9/tinymce/7/tinymce.min.js" referrerpolicy="origin")

    script.
      const pathAdmin = "#{pathAdmin}";

    script(src="/admin/assets/js/tinymce-config.js")
  body

    - if (messages.success)
      div(class="alert alert-success" alert-time="3000")
        span #{messages.success}
    
    //- Header
    include ../partials/header.pug
    //- End Header

    //- Sider
    include ../partials/sider.pug
    //- End Sider

    //- Main
    main.main
      block main
    //- End Main

    script(src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js")
    script(src="https://cdn.jsdelivr.net/npm/filepond-plugin-image-preview@4.6.12/dist/filepond-plugin-image-preview.min.js")
    script(src="https://cdn.jsdelivr.net/npm/filepond-plugin-file-validate-type@1.2.9/dist/filepond-plugin-file-validate-type.min.js")
    script(src="https://cdn.jsdelivr.net/npm/filepond@4.32.7/dist/filepond.min.js")
    script(src="https://cdn.jsdelivr.net/npm/chart.js") 
    script(src="https://cdn.jsdelivr.net/npm/just-validate@4.3.0/dist/just-validate.production.min.js")
    script(src="/admin/assets/js/script.js") 